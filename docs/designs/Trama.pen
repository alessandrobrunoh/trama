            {
              "type": "text",
              "id": "afL6i",
              "name": "Trama is a task hub that",
              "fill": "$d-text-2",
              "textGrowth": "fixed-width",
              "width": 1100,
              "content": "Trama is a cloud task hub (web + mobile) between any issue tracker and Delta. It never talks to agents and never shows them running — that happens in Delta. A small desktop connector, running next to Delta, links threads to tasks and uploads a read-only record: summary, decisions, key events, files and diff stats.",
              "lineHeight": 1.55,
              "fontFamily": "$d-sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
