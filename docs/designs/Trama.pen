                          "content": "/ˈtra·ma/ · Italian · weft, and also plot",
                          "fontFamily": "$d-mono",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "Z5iDS",
                          "name": "Weft is the thread woven",
                          "fill": "#BFC1C5",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Weft is the thread woven across the warp to make fabric. Delta gives you the threads; Trama weaves them into tasks. In Italian it also means plot — the story of how the work went.",
                          "lineHeight": 1.55,
                          "fontFamily": "$d-sans",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
