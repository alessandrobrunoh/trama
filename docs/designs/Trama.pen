                  "fontFamily": "$d-serif",
                  "fontSize": 16,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "P8DmI4",
                  "name": "Delta has threads.\nWhat ",
                  "fill": "$d-text",
                  "content": "Delta has threads.\nWhat do you call the place that keeps them?",
                  "lineHeight": 1.1,
                  "fontFamily": "$d-serif",
                  "fontSize": 52,
                  "fontWeight": "normal",
                  "letterSpacing": -1
                }
              ]
            },
            {
              "type": "text",
              "id": "BW8y6",
              "name": "The product plans work, ",
              "fill": "#BFC1C5",
              "textGrowth": "fixed-width",
              "width": 820,
              "content": "The product plans work, links one Delta thread per task and keeps the record forever. The strongest names extend Delta's own vocabulary — threads, rivers — instead of describing features.",
              "lineHeight": 1.55,
              "fontFamily": "$d-sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
