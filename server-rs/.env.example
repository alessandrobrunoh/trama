# Copy to .env (gitignored); loaded by the server and by the test fixtures.
# Names, defaults and parsing match server/.env.example so both APIs can share one configuration
# (see trama_core::config for the details of each variable).

# 3000 once the Rust API replaces NestJS; while both run, give Rust its own port.
PORT=3100
# Same database as the NestJS API (docker compose `delta-postgres`, host port 5435).
DATABASE_URL=postgres://delta:delta@localhost:5435/trama
# Tests create and drop their own `trama_rs_test_*` databases on this server; the database
# named here is never touched. Unset: database tests are skipped.
TEST_DATABASE_URL=postgres://delta:delta@localhost:5435/trama_core_test
# Allowed browser origins, comma-separated (credentials are allowed).
# default: http://localhost:4300, http://127.0.0.1:4300, http://localhost:4301, http://127.0.0.1:4301
CORS_ORIGIN=http://localhost:4300,http://localhost:4301
# production: HSTS, Secure session cookie, https-only outbound requests, no demo seed,
# /api/admin/* disabled, no /api/docs or /api/openapi.json, encryption key required
NODE_ENV=development
# Log filter (tracing EnvFilter syntax)
RUST_LOG=trama=info,tower_http=info,sqlx=warn

# AI suggestions and assistant (OpenAI-compatible Chat Completions API).
# HTTPS base URL including /v1; do not include /chat/completions. Leave all three empty to disable AI.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# MCP server used by the Assistant (see mcp/README.md). Empty: the Assistant is text-only.
MCP_URL=
# Cap on workspace changes the Assistant may make per user per day (default 200)
AI_ASSISTANT_MAX_WRITES_PER_DAY=200

# Optional official Grok Build client. GROK_HOME_DIR empty: Grok Build is unavailable.
GROK_CLI_PATH=grok
GROK_HOME_DIR=

# Invitation emails. Empty SMTP_URL: nothing is sent and the invite link is shown in the UI.
# smtps:// uses implicit TLS, smtp:// STARTTLS when the server offers it
# (query options: secure=true, requireTLS=true, ignoreTLS=true, tls.rejectUnauthorized=false).
SMTP_URL=
MAIL_FROM=Trama <no-reply@example.com>
# Base URL of the web app, used in links inside emails. Default: the first CORS_ORIGIN.
APP_URL=

# Web Push. Leave both keys empty to disable (npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# POST /api/admin/reset wipes ALL data and re-seeds the demo workspace, without authentication.
# Off unless exactly "true", and never when NODE_ENV=production. Local development only.
TRAMA_ENABLE_ADMIN_RESET=false

# --- Rate limiting (per client IP, in memory, one counter set per API process) ---
# Over the limit the API answers 429 with Retry-After. On by default; off when NODE_ENV=test.
# TRAMA_RATE_LIMIT_ENABLED=false turns it off, true forces it on.
# Behind a reverse proxy set TRAMA_TRUST_PROXY (hop count such as 1, true, or a subnet list like
# "loopback, 10.0.0.0/8"), otherwise every client shares the proxy's address and one bucket.
TRAMA_TRUST_PROXY=
TRAMA_RATE_LIMIT_ENABLED=
TRAMA_RATE_LIMIT_GLOBAL_PER_MIN=1200
TRAMA_RATE_LIMIT_LOGIN_PER_15MIN=10
TRAMA_RATE_LIMIT_SIGNUP_PER_HOUR=10
TRAMA_RATE_LIMIT_INVITE_PER_15MIN=30
TRAMA_RATE_LIMIT_PUBLIC_VIEW_PER_MIN=30
TRAMA_RATE_LIMIT_CREDENTIALS_PER_HOUR=30

# How often an open live-event stream re-checks its credential, in ms (default 30000, minimum 100)
TRAMA_SSE_RECHECK_MS=30000
# Delay before an outgoing webhook's single retry, in ms (default 2000; an empty value means 0)
# TRAMA_WEBHOOK_RETRY_MS=2000
# off: do not run queued imports in this process
TRAMA_IMPORT_RUNNER=

# SEED_DEMO=false skips seeding the demo workspace into an empty database (never in production);
# SEED_MOCK_HISTORY=false seeds it without the mock activity history.
SEED_DEMO=true
SEED_MOCK_HISTORY=true
# Sign-in demo panel. 1/true/yes/on or 0/false/no/off. Unset: shown outside production.
DEMO_LOGIN=

# Optional public roadmap and changelog Shared Views. These link tokens are public capabilities.
PUBLIC_ROADMAP_VIEW_TOKEN=
PUBLIC_CHANGELOG_VIEW_TOKEN=

# --- Secrets at rest (integration tokens, webhook secrets, public view links) ---
# AES-256 key: 64 hex chars, 32 bytes as base64, or any passphrase. Generate: openssl rand -base64 32
# Required when NODE_ENV=production; development falls back to a public key and warns loudly.
# The older names NABLA_ENCRYPTION_KEY and SECRETS_KEY are still read, in that order.
# Leave the line commented out rather than empty when you use SECRETS_KEY: an empty
# TRAMA_ENCRYPTION_KEY= selects the development key, as it does in NestJS.
# TRAMA_ENCRYPTION_KEY=
# Externally reachable base URL of this API, used to build the webhook URLs shown to admins
PUBLIC_URL=http://localhost:3000

# --- Outbound requests to user-supplied URLs (SSRF guard) ---
# Webhooks, Web Push endpoints and self-hosted GitHub / GitLab URLs are only contacted at public
# addresses; redirects are not followed; http:// is refused in production. Cloud metadata
# addresses stay blocked either way.
TRAMA_OUTBOUND_ALLOW_PRIVATE=false
# Or allow only specific hosts, comma-separated (exact name, IP, or *.suffix)
TRAMA_OUTBOUND_ALLOWED_HOSTS=
