# Copy to .env (gitignored); loaded by the server and by the test fixtures.
# Names and defaults match server/.env.example so both APIs can share one configuration.

# 3000 once the Rust API replaces NestJS; while both run, give Rust its own port.
PORT=3100
# Same database as the NestJS API (docker compose `delta-postgres`, host port 5435).
DATABASE_URL=postgres://delta:delta@localhost:5435/trama
# Tests create and drop their own `trama_rs_test_*` databases on this server; the database
# named here is never touched. Unset: database tests are skipped.
TEST_DATABASE_URL=postgres://delta:delta@localhost:5435/trama_core_test
# Allowed browser origins, comma-separated (credentials are allowed).
CORS_ORIGIN=http://localhost:4300,http://localhost:4301
# production: HSTS header, no /api/docs or /api/openapi.json
NODE_ENV=development
# Log filter (tracing EnvFilter syntax)
RUST_LOG=trama=info,tower_http=info,sqlx=warn
