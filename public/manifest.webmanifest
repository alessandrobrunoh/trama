{
  "id": "/",
  "name": "Trama \u2014 Work for humans and agents",
  "short_name": "Trama",
  "description": "Issues, workstreams and decisions for teams of people and coding agents.",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "scope": "/",
  "start_url": "/a/launch?source=pwa",
  "categories": [
    "productivity",
    "business"
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "description": "Everything waiting on you",
      "url": "/a/launch?go=inbox&source=shortcut",
