# Configuration of docker-compose.selfhost.yml. Copy it to `.env` next to the compose file and fill it in:
#   cp docker/selfhost.env.example .env
# Never commit the real file. Guide: docs/self-hosting.md

# --- Required (compose refuses to start while one is empty) ----------------------------------------------------

# The address people type in the browser. https://... makes the proxy fetch a Let's Encrypt certificate
# (the DNS name must point at this host, ports 80 and 443 must be open). http://localhost is for a local trial.
TRAMA_PUBLIC_URL=

# Postgres password. Generate: openssl rand -hex 24   (hex only: it is placed inside a connection URL)
# It only applies when the data volume is first created; see docs/self-hosting.md to change it later.
POSTGRES_PASSWORD=

# Encrypts integration tokens and webhook secrets at rest. Generate: openssl rand -base64 32
# Back it up with the database and NEVER change it: stored secrets become unreadable.
TRAMA_ENCRYPTION_KEY=

# --- Versions --------------------------------------------------------------------------------------------------

# Image tag of all three images. Pin a release (e.g. 0.1.0) instead of `latest` so upgrades are deliberate.
TRAMA_VERSION=latest
# Where the images come from.
# TRAMA_REGISTRY=ghcr.io/alessandrobrunoh

# --- Network ---------------------------------------------------------------------------------------------------

# Ports the proxy publishes. If TRAMA_PUBLIC_URL has a port (http://localhost:8080), set TRAMA_HTTP_PORT to it.
# TRAMA_HTTP_PORT=80
# TRAMA_HTTPS_PORT=443

# Proxy hops in front of the API, for client addresses and rate limiting. 1 = the bundled proxy only.
# Behind another proxy or load balancer (Cloudflare, a cloud LB, nginx...) use 2.
# TRAMA_TRUST_PROXY=1

# --- Email (optional): invitation emails. Empty = not sent, the invite link is shown in the UI -----------------

# smtps://user:pass@smtp.example.com:465 (implicit TLS) or smtp://user:pass@smtp.example.com:587 (STARTTLS)
SMTP_URL=
MAIL_FROM=Trama <no-reply@example.com>

# --- AI (optional): suggestions and assistant, any OpenAI-compatible Chat Completions API. Empty = off --------

AI_API_URL=
AI_API_KEY=
AI_MODEL=

# --- Browser push (optional): npx web-push generate-vapid-keys. Empty = off ------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
