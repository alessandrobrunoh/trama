# Production environment for the Trama API (docker compose service `app`).
# Copy to .env.production on the server, fill every CHANGE_ME, never commit the real file.
# Public URL: https://trama.alessandrobrunoh.it

# HTTP port inside the container (Traefik forwards to it)
PORT=3000

# production: Secure session cookie, no demo seed, /api/admin/* disabled
NODE_ENV=production
SEED_DEMO=false

# PostgreSQL: host is the compose service name. The password must match POSTGRES_PASSWORD, which the compose
# file reads from the stack's environment (default "delta"). Set both to the same random value
# (openssl rand -hex 24). With deploy tools, define POSTGRES_PASSWORD next to these variables; when running
# compose by hand, pass this file: docker compose --env-file server/.env.production -f server/docker-compose.yml up -d
DATABASE_URL=postgres://delta:CHANGE_ME@postgres:5432/trama

# Browser origin allowed to call the API with cookies, and the public base URLs.
CORS_ORIGIN=https://trama.alessandrobrunoh.it
# Base URL of the web app (links inside emails). Default would be the first CORS_ORIGIN.
APP_URL=https://trama.alessandrobrunoh.it
# Externally reachable base URL of the API, used to build the webhook URLs shown to admins.
PUBLIC_URL=https://trama.alessandrobrunoh.it

# Encryption of integration tokens and webhook secrets at rest (required in production).
# Generate with: openssl rand -base64 32
# Never change it once data is stored. (The legacy names NABLA_ENCRYPTION_KEY and SECRETS_KEY are still
# read as fallbacks, so an existing deployment keeps working without renaming anything.)
TRAMA_ENCRYPTION_KEY=CHANGE_ME

# AI suggestions and assistant (OpenAI-compatible Chat Completions API, HTTPS base URL with /v1).
AI_API_URL=https://ollama.com/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=gpt-oss:120b-cloud

# Assistant tools: the Trama MCP server, reached over the compose network (service `mcp`).
MCP_URL=http://mcp:8080/mcp
# Cap on workspace changes the Assistant may make per user per day (counted per API process)
AI_ASSISTANT_MAX_WRITES_PER_DAY=200

# Optional official Grok Build client: needs the CLI in the image and a private persistent volume.
GROK_CLI_PATH=grok
GROK_HOME_DIR=

# Invitation emails. Leave SMTP_URL empty to skip sending (the invite link is shown in the UI).
# smtps:// = implicit TLS, smtp:// = STARTTLS when offered.
SMTP_URL=
MAIL_FROM=Trama <no-reply@trama.alessandrobrunoh.it>
