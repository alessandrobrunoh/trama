# Copy to .env (gitignored): loaded automatically by `npm run start` and the migration CLI.

# HTTP port (API under /api)
PORT=3000

# AI suggestions and assistant (OpenAI-compatible Chat Completions API).
# HTTPS base URL including /v1; do not include /chat/completions.
# Leave all three empty to disable AI. Secrets remain on the server.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# MCP server used by the Assistant to read and change the workspace (see mcp/README.md).
# Leave empty to keep the Assistant text-only. Docker: http://mcp:8080/mcp; local: http://localhost:8080/mcp
MCP_URL=
# Cap on workspace changes the Assistant may make per user per day (default 200)
AI_ASSISTANT_MAX_WRITES_PER_DAY=200

# Optional official Grok Build client (SuperGrok login via device code).
# Install @xai-official/grok in the API runtime and mount this path as a private persistent volume.
GROK_CLI_PATH=grok
GROK_HOME_DIR=

# PostgreSQL (docker compose service `delta-postgres`, host port 5434).
# The `trama` database is created automatically on boot if it does not exist.
DATABASE_URL=postgres://delta:delta@localhost:5434/trama
# e2e tests use a separate database in the same container (created automatically)
TEST_DATABASE_URL=postgres://delta:delta@localhost:5434/trama_core_test

# Invitation emails (Settings → Members). Leave SMTP_URL empty to skip sending: the invite link is then
# shown in the UI to share by hand. smtps:// uses implicit TLS, smtp:// STARTTLS when the server offers it.
SMTP_URL=
MAIL_FROM=Trama <no-reply@example.com>
# Base URL of the web app, used in links inside emails. Default: the first CORS_ORIGIN.
APP_URL=

# Push notifications (system notifications on people's devices, via Web Push). Leave both empty to disable.
# Generate a pair once with: npx web-push generate-vapid-keys   (keep the private key secret; changing the
# pair invalidates every registered device). VAPID_SUBJECT is a mailto: or https URL identifying you to push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Allowed browser origins, comma-separated (credentials are allowed)
# default: http://localhost:4300, http://127.0.0.1:4300, http://localhost:4301, http://127.0.0.1:4301
CORS_ORIGIN=http://localhost:4300,http://localhost:4301

# production: Secure session cookie, no demo seed, /api/admin/* always disabled
NODE_ENV=development
# POST /api/admin/reset wipes ALL data and re-seeds the demo workspace, without authentication.
# Off unless this is exactly "true" (and never on when NODE_ENV=production). Local development only.
TRAMA_ENABLE_ADMIN_RESET=false
# --- Rate limiting (per client IP, in memory, one counter set per API process) ---
# Over the limit the API answers 429 with a Retry-After header. On by default; off when NODE_ENV=test.
# TRAMA_RATE_LIMIT_ENABLED=false turns it off, true forces it on.
# Behind a reverse proxy set TRAMA_TRUST_PROXY (hop count such as 1, true, or an Express subnet list like
# "loopback, 10.0.0.0/8"), otherwise every client shares the proxy's address and one bucket.
TRAMA_TRUST_PROXY=
TRAMA_RATE_LIMIT_ENABLED=
# every /api route (default 1200 per minute)
TRAMA_RATE_LIMIT_GLOBAL_PER_MIN=1200
# POST /auth/login (10 per 15 minutes), POST /auth/signup (10 per hour)
TRAMA_RATE_LIMIT_LOGIN_PER_15MIN=10
TRAMA_RATE_LIMIT_SIGNUP_PER_HOUR=10
# GET /invites/:token and POST /invites/:token/accept (30 per 15 minutes)
TRAMA_RATE_LIMIT_INVITE_PER_15MIN=30
# GET /public/views/:token (30 per minute)
TRAMA_RATE_LIMIT_PUBLIC_VIEW_PER_MIN=30
# POST /w/:slug/tokens and /w/:slug/agents, which mint credentials (30 per hour)
TRAMA_RATE_LIMIT_CREDENTIALS_PER_HOUR=30

# How often an open live-event stream (SSE) re-checks that its session/token is still valid and the person is
# still a workspace member, in milliseconds (default 30000, minimum 100)
TRAMA_SSE_RECHECK_MS=30000

# set SEED_DEMO=false to skip seeding the demo workspace into an empty database
SEED_DEMO=true

# Key material for encrypting integration secrets at rest (set to a long random string in production)
SECRETS_KEY=

# --- Integrations (GitHub / GitLab / Delta) ---
# AES-256 key for tokens and webhook secrets at rest: 64 hex chars, 32 bytes as base64, or any passphrase.
# Generate: openssl rand -base64 32   (required when NODE_ENV=production; dev falls back to a public key and warns loudly)
TRAMA_ENCRYPTION_KEY=
# Externally reachable base URL of this API, used to build the webhook URLs shown to admins
PUBLIC_URL=http://localhost:3000
